      "id": "item-0011",
      "source_id": "src-0003",
      "kind": "audit-finding",
      "title": "internal-review-2026-08.md",
      "section": "H-02 Backing check after a shadow draw",
      "page": 1,
      "quote": "The `distributeSurplus` path reads `backingCheck` after the ledger write, so a",
      "identifiers": [
        "backingcheck",
        "distributesurplus",
        "reservebackingshortfall"
      ],
      "mechanism_class": "stale_cached_value",
      "clause_class": null,
      "text": "The `distributeSurplus` path reads `backingCheck` after the ledger write, so a\n1 wei shadow draw makes `ReserveBackingShortfall` fire on every later distribution.\nThe audit recommended refreshing the cached total before the check."
    },
    {
      "id": "item-0012",
      "source_id": "src-0003",
      "kind": "audit-finding",
      "title": "internal-review-2026-08.md",
      "section": "M-04 Oracle bounds",
      "page": 1,
      "quote": "The `priceOracle` read has no staleness bound, so a stale answer is accepted for up to",
      "identifiers": [
        "priceoracle"
      ],
      "mechanism_class": "oracle_bounds_or_staleness",
      "clause_class": null,
      "text": "The `priceOracle` read has no staleness bound, so a stale answer is accepted for up to\none hour after the feed stops updating."
    }
  ]
