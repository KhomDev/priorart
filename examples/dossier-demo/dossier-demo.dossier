    {
      "id": "item-0013",
      "source_id": "src-0003",
      "kind": "audit-finding",
      "title": "internal-review.md",
      "section": "M-03 Fee index rounding",
      "page": 1,
      "quote": "The consistency check in `FeeLedger.distributeFees` reverts with `FeeAccountingMismatch` when the fee index rounds up past the collected balance.",
      "identifiers": [
        "FeeAccountingMismatch",
        "FeeLedger",
        "FeeLedger.distributeFees"
      ],
      "mechanism_class": "rounding_direction",
      "clause_class": null,
      "text": "The consistency check in `FeeLedger.distributeFees` reverts with `FeeAccountingMismatch`\nwhen the fee index rounds up past the collected balance. The cause is rounding in the index\nupdate, not loan closure; the fix rounds the index down. Severity: Medium."
    }
  ]
