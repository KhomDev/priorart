    {
      "id": "item-0013",
      "source_id": "src-0003",
      "kind": "audit-finding",
      "title": "internal-review.md",
      "section": "H-02 Reserve backing check",
      "page": 1,
      "quote": "The backing check in `BalanceSheet.distributeSurplus` reverts with `ReserveBackingShortfall` when the stable reserve is smaller than the summed debt of fee-exempt collateral types.",
      "identifiers": [
        "BalanceSheet",
        "BalanceSheet.distributeSurplus",
        "PegStabilityModule",
        "PegStabilityModule.sellStable",
        "ReserveBackingShortfall",
        "VaultEngine",
        "VaultEngine.open"
      ],
      "mechanism_class": "accounting_order_of_operations",
      "clause_class": null,
      "text": "The backing check in `BalanceSheet.distributeSurplus` reverts with `ReserveBackingShortfall`\nwhen the stable reserve is smaller than the summed debt of fee-exempt collateral types. The check\nassumes every such debt has a reserve counterpart from `PegStabilityModule.sellStable`.\n\nThe review's test drove the shortfall only through direct ledger writes, never through\n`VaultEngine.open` on a fee-exempt collateral type. Severity: High. Reported 2026-08-14."
    }
  ]
