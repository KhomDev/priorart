  "query": "one paid-unique primary or one judged duplicate of the Dup-Bench validation split that did not abstain; abstained queries produce no alarm and are excluded",
  "top_candidate": "the candidate with the highest PA-B4 ranker score (weights v1); ties keep the default candidate order",
  "alarm": "fires when the calibrated probability of the top score is >= the threshold",
  "true_alarm": "the query is a judged duplicate and its top candidate is its judged primary (pair label 1); any alarm on a paid-unique primary is false (PA-B4 FAR definition); an alarm naming a different primary is false",
  "precision": "k / n over validation queries whose calibrated top score is >= threshold; k = true alarms; Wilson 95% interval with z = 1.959964",
  "threshold_rule": "the lowest isotonic block value whose precision Wilson lower bound is >= 0.80; none qualifies -> the alarm is off",
  "calibration_map": "a step function over the raw top score: a score s maps to the value of the last block whose score_lo <= s; a score below the first block's score_lo maps to the first block's value"
 },
